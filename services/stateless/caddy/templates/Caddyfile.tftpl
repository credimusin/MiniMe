{
	email bmo@${base_domain}
	log {
		level ERROR
	}
}

www.${base_domain} {
	${tls_directive}
	redir https://${base_domain}{uri} permanent
}

${base_domain} {
	${tls_directive}
	reverse_proxy ${imaginaldev_upstream}
}

bmo.${base_domain} {
	${tls_directive}
	reverse_proxy ${bmoblog_upstream}
}

minime.${base_domain} {
	${tls_directive}
	reverse_proxy ${minimestatus_upstream}
}

forgejo.${base_domain} {
	${tls_directive}
	reverse_proxy ${forgejo_upstream}
}

innerlight.${base_domain} {
	${tls_directive}
	reverse_proxy ${innerlight_upstream}
}

quack.${base_domain} {
	${tls_directive}
	request_body {
		max_size 1GB
	}

	@matrix path /_matrix/* /.well-known/matrix/*
	handle @matrix {
		reverse_proxy ${tuwunel_upstream}
	}

	handle {
		reverse_proxy ${quackindex_upstream}
	}
}
