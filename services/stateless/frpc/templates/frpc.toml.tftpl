serverAddr = "${vps_addr}"
serverPort = ${vps_port}

transport.tls.enable = true
auth.method = "token"
auth.token = "${auth_token}"

[[proxies]]
name = "caddy-http"
type = "tcp"
localIP = "${caddy_host}"
localPort = 80
remotePort = 80

[[proxies]]
name = "caddy-https"
type = "tcp"
localIP = "${caddy_host}"
localPort = 443
remotePort = 443

[[proxies]]
name = "caddy-http3"
type = "udp"
localIP = "${caddy_host}"
localPort = 443
remotePort = 443

[[proxies]]
name = "forgejo-ssh"
type = "tcp"
localIP = "${forgejo_host}"
localPort = 2222
remotePort = ${ssh_port}
