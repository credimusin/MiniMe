# Non-sensitive configuration (copy to terraform.tfvars)
# Sensitive passwords are stored in `pass` (Standard Unix Password Manager):
#   pass generate --no-symbols minime/postgres/admin 32
#   pass generate --no-symbols minime/postgres/forgejo 32
# Run OpenTofu via: ./scripts/tofu.sh plan | ./scripts/tofu.sh apply

# ==============================================================================
# Global / Ingress
# ==============================================================================
# docker_host = "ssh://monster/run/user/1000/podman/podman.sock"
base_domain  = "homelab.internal"
tls_internal = true

# ==============================================================================
# Services: Stateless
# ==============================================================================
forgejo_ssh_port = 2222
