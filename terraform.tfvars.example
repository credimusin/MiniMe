# Copy to terraform.tfvars (or split into stateful.auto.tfvars, services.auto.tfvars, projects.auto.tfvars)
# Generate strong passwords via: openssl rand -base64 24

# ==============================================================================
# Global / Ingress
# ==============================================================================
# docker_host = "ssh://monster/run/user/1000/podman/podman.sock"
base_domain  = "homelab.internal"
tls_internal = true

# ==============================================================================
# 1. Services: Stateful (Root database & storage credentials)
# ==============================================================================
postgres_admin_password = "CHANGE_ME_POSTGRES_SUPERUSER_PASSWORD"

# ==============================================================================
# 2. Services: Stateless (Self-hosted infrastructure apps)
# ==============================================================================
forgejo_db_password = "CHANGE_ME_FORGEJO_DB_PASSWORD"
forgejo_ssh_port    = 2222

# ==============================================================================
# 3. Projects (Custom pet-projects)
# ==============================================================================
# example_project_db_password = "CHANGE_ME_PROJECT_DB_PASSWORD"
